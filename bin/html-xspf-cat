#! /usr/bin/python3 -B
# xspf-cat

import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "lib"))
from xspflib import Playlist

assert sys.argv[1] == "-o"
output_filename = sys.argv[2]
outpl = Playlist()
for filename in sys.argv[3:]:
	inpl = Playlist(filename)
	for track in inpl:
		outpl.append(track)
outpl.save(output_filename)

